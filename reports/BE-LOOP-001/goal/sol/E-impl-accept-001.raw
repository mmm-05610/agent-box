    82	    and its persistence is the caller's responsibility.
    83	    """
    84	
    85	    execution_key: str
    86	    bundle_ref: str
    87	    resource_bindings: tuple[NeutralBinding, ...] = ()
    88	    capability_demand: frozenset[str] = frozenset()
    89	    deadline_policy: DeadlinePolicy | None = None
    90	    correlation: Mapping[str, str] = field(default_factory=dict)
    91	
    92	    def __post_init__(self) -> None:
    93	        object.__setattr__(self, "correlation", MappingProxyType(dict(self.correlation)))
    94	
    95	
    96	@dataclass(frozen=True)
    97	class ExecutionReceipt:
    98	    """Answer to ``submit``. A replay of a known key returns the original
    99	    receipt with ``replayed=True`` and never re-dispatches the start."""
   100	
   101	    execution_key: str
   102	    dispatch_id: str
   103	    replayed: bool = False
   104	
   105	
   106	@dataclass(frozen=True)
   107	class ExecutionObservation:
   108	    """Pure-read answer to ``observe_execution``: current knowledge plus the
   109	    evidence class it rests on. Producing one dispatches nothing."""
   110	
   111	    execution_key: str
   112	    state: ObservationState
   113	    evidence: EvidenceClass
   114	    observed_at: datetime
   212	        raise ValueError("SIDECAR_RUNTIME_ARTIFACT_DECLARATION_DUPLICATED")
   213	    if declared != mounted:
   214	        raise ValueError("SIDECAR_RUNTIME_ARTIFACT_DECLARATION_MISMATCH")
   215	
   216	
   217	def _safe_bundle_relative(value: str) -> bool:
   218	    return (isinstance(value, str) and not value.startswith("/")
   219	            and "\x00" not in value and "//" not in value
   220	            and not any(part in {"", ".", ".."} for part in value.split("/")))
   221	
   222	
   223	def sidecar_bundle_files(
   224	    plugin_root: Path | str, *,
   225	    closure: Sequence[tuple[str, str]] | None = None,
   226	    additional_files: Mapping[str, bytes] | None = None,
   227	) -> dict[str, bytes]:
   228	    """Load the reviewed sidecar closure for one bounded Worker projection.
   229	
   230	    E-INC1a (a-6): ``closure`` is the neutral seam - a pure data list of
   231	    ``(source_relative, target_relative)`` pairs. When given, this function
   232	    assembles exactly what the declaration says (path-safety validation and
   233	    bounds unchanged) and touches none of the literal view layout below.
   234	    The ``closure=None`` branch is the *frozen compatibility shell* for the
   235	    bootstrap call site's two-positional shape: the hardcoded
   236	    view-layout names are Harness-runtime content, owned by H (C-HARNESS,
   237	    IFR-04), and this shell leaves with INC1b once that declaration exists -
   238	    nothing outside it may grow these literals (pinned in the group tests).
   239	    """
   240	    root = Path(plugin_root).resolve()
   241	    if closure is not None:
   242	        files: dict[str, bytes] = {}
   243	        for source_relative, target_relative in closure:
   244	            if not _safe_bundle_relative(source_relative) or not _safe_bundle_relative(target_relative):
   245	                raise ValueError("SIDECAR_BUNDLE_PATH_INVALID")
   246	            if target_relative in files:
   247	                raise ValueError("SIDECAR_BUNDLE_PATH_CONFLICT")
   248	            files[target_relative] = (root / source_relative).read_bytes()
   249	        return _finish_bundle(files, additional_files)
   250	    runtime = root / "runtime"
   251	    snapshot = root / "third_party" / "harness_remote"
   252	    source = json.loads((snapshot / "SOURCE.json").read_text(encoding="utf-8"))
   253	    files = {
   254	        "agentbox-sidecar/package.json": (runtime / "package.json").read_bytes(),
   255	        "agentbox-sidecar/runtime/worker-entry.mjs": (runtime / "worker-entry.mjs").read_bytes(),
   256	        "agentbox-sidecar/runtime/native-driver.mjs": (runtime / "native-driver.mjs").read_bytes(),
   257	        # The validated static ceiling, so the sidecar can refuse to project a
   258	        # capability its Harness never declared instead of guessing.
   259	        "agentbox-sidecar/runtime/capability_declarations.json": (
   260	            runtime / "capability_declarations.json"
   261	        ).read_bytes(),
   262	        "agentbox-sidecar/runtime/profile_extensions.mjs": (
   263	            runtime / "profile_extensions.mjs"
   264	        ).read_bytes(),
   265	        # Order 65 C: the delegation bridge - the stdio MCP server a parent
   266	        # Harness starts when its Profile holds delegation grants.
   267	        "agentbox-sidecar/runtime/subagent-bridge.mjs": (
   268	            runtime / "subagent-bridge.mjs"
   269	        ).read_bytes(),
   270	        "agentbox-sidecar/third_party/harness_remote/SOURCE.json": (
   271	            snapshot / "SOURCE.json"
   272	        ).read_bytes(),
   273	    }
   274	    for item in source.get("files", ()):
   275	        relative = str(item["path"])
   276	        files[f"agentbox-sidecar/third_party/harness_remote/{relative}"] = (
   277	            snapshot / relative
   278	        ).read_bytes()
   279	    return _finish_bundle(files, additional_files)
   280	
   281	
   282	def _finish_bundle(
   283	    files: dict[str, bytes], additional_files: Mapping[str, bytes] | None,
   284	) -> dict[str, bytes]:
   285	    """Shared tail: caller extras and the worker bounds, identical for both
   286	    the declared-closure path and the frozen compatibility shell."""
   287	    for relative, content in (additional_files or {}).items():
   288	        if not _safe_bundle_relative(relative):
   289	            raise ValueError("SIDECAR_BUNDLE_PATH_INVALID")
   290	        if relative in files:
   291	            raise ValueError("SIDECAR_BUNDLE_PATH_CONFLICT")
   292	        files[relative] = bytes(content)
   293	    if len(files) > 1024 or sum(map(len, files.values())) > 64 * 1024 * 1024:
   294	        raise ValueError("SIDECAR_BUNDLE_OUTSIDE_WORKER_BOUNDS")
   295	    return files
   296	
   297	
   298	class WorkerSidecarLauncher:
   299	    """Launch the reviewed sidecar through one Worker's interactive channel.
   300	
   301	    The Worker is the host boundary, and this launcher is what it looks like from
   302	    the product side: stage the bytes, ask the sandbox layer for the room, spawn,
   303	    stream, capture. Which machine the Worker runs on is the connector's fact,
   304	    not this class's - a WSL Worker and an SSH Worker take exactly this path, and
   305	    neither one makes this layer know a host name.

