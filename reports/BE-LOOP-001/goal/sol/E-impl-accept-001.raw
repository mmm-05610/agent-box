from __future__ import annotations

import json
import os
import threading
from pathlib import Path

import pytest

os.environ.setdefault("AGENT_BOX_SANDBOX_MODULE", "agent_box_sandbox_bwrap")

from fastapi.testclient import TestClient

from agent_box.server.bootstrap import build_runtime
from agent_box.server.execution import HarnessDescriptor, HarnessRegistry
from agent_box.server.transport.http import create_app

ENVIRONMENT = {"kind": "wsl", "host": "Ubuntu", "user": None}
MESSAGE = {"text": "hello", "attachments": []}


class FakeConnector:
    def open_workspace(self, probe_id, path):
        return {"connection_id": f"conn-{path}", "distribution": "Ubuntu",
                "user": "tester", "path": path}

    def probe(self, distribution, user):
        return {"probe_id": f"probe-{distribution}", "distribution": distribution, "user": user}

    def browse(self, probe_id, path):
        return {"path": path, "directories": [], "files": []}


class ConfigurablePort:
    """fake `TurnExecutionPort`：accept 阻塞（turn 停在执行中），cancel 返回配置值。"""

    def __init__(self, *, cancel_returns: bool):
        self.cancel_returns = cancel_returns
        self.lock = threading.Lock()
        self.accepted: list[str] = []
        self.cancelled: list[str] = []
        self.gate = threading.Event()

    def accept(self, execution_id, *, overrides=None):
        with self.lock:
            self.accepted.append(execution_id)
        self.gate.wait(5)

    def cancel(self, execution_id):
        with self.lock:
            self.cancelled.append(execution_id)
        return self.cancel_returns


def registry() -> HarnessRegistry:
    reg = HarnessRegistry()
    reg.register(HarnessDescriptor(
        "alpha", capability_claims={"stream": True},
        control_options={"model": ("alpha-default", "alpha-fast")},
        security_locked_controls=("sandbox",),
        configuration_validator=lambda value: None if isinstance(value, dict) else ValueError(),
    ))
    return reg


class Wire:
    def __init__(self, client, headers):
        self.client = client
        self.headers = headers
        self.counter = 0

    def ok(self, method, params):
        self.counter += 1
        response = self.client.post(
            f"/wire/v1/{method}", headers=self.headers,
            json={"jsonrpc": "2.0", "id": f"req-{self.counter}", "method": method, "params": params},
        )
        body = response.json()
        assert "result" in body, (method, body)
        assert response.status_code == 200, (method, response.status_code, body)
        return body["result"]


def make_server(tmp_path: Path, *, cancel_returns: bool):
    port = ConfigurablePort(cancel_returns=cancel_returns)
    runtime = build_runtime(
        tmp_path / "data", harnesses=registry(), connector=FakeConnector(), execution=port,
    )
    client = TestClient(create_app(runtime), base_url="http://127.0.0.1")
    client.__enter__()
    try:
        api = Wire(client, {"Authorization": f"Bearer {runtime.token}"})
        workspace = api.ok("workspaces.open", {
            "requestId": "block1-open", "environment": ENVIRONMENT, "path": "/home/tester/b1",
        })["workspace"]
        profile = client.post(
            "/api/v1/profiles",
            headers={**api.headers, "Idempotency-Key": "block1-profile"},
            json={"name": "b1", "harness_type": "alpha",
                  "configuration": {"model": "alpha-default"}, "credential_id": None},
        )
        assert profile.status_code == 201, profile.json()
        accepted = api.ok("sessions.createAndSend", {
            "requestId": "block1-send", "workspaceId": workspace["id"],
            "profileId": profile.json()["profile_id"], "message": MESSAGE, "overrides": [],
        })
        return runtime, client, api, port, accepted
    except Exception:
        client.__exit__(None, None, None)
        raise


