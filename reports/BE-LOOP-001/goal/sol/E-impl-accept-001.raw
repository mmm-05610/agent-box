class TriStatePort:
    """block-1 端口形态的 S 侧消费夹具：新三态方法 + bool 兼容壳（E 删壳前的双轨）。"""

    def __init__(self, outcome: str):
        self.outcome = outcome
        self.outcome_calls: list[str] = []
        self.bool_calls: list[str] = []
        import threading
        self.gate = threading.Event()

    def accept(self, execution_id, *, overrides=None):
        self.gate.wait(5)

    def cancel_outcome(self, execution_id) -> str:
        self.outcome_calls.append(execution_id)
        return self.outcome

    def cancel(self, execution_id) -> bool:  # 兼容壳：仅 confirmed 为 True
        self.bool_calls.append(execution_id)
        return self.outcome == "confirmed_stopped"


def make_tri_server(tmp_path, outcome: str):
    """make_server 的三态端口版（复用其装配，仅替换 execution 端口）。"""
    import agent_box.server.bootstrap as bootstrap
    from agent_box.server.execution import HarnessDescriptor, HarnessRegistry
    from agent_box.server.transport.http import create_app
    from test_block1_cancel_public_shape_s import ENVIRONMENT, FakeConnector, Wire
    from fastapi.testclient import TestClient

    port = TriStatePort(outcome)
    registry = HarnessRegistry()
    registry.register(HarnessDescriptor(
        "alpha", capability_claims={"stream": True},
        control_options={"model": ("alpha-default",)},
        security_locked_controls=("sandbox",),
        configuration_validator=lambda v: None if isinstance(v, dict) else ValueError(),
    ))
    runtime = bootstrap.build_runtime(
        tmp_path / "data", harnesses=registry, connector=FakeConnector(), execution=port)
    client = TestClient(create_app(runtime), base_url="http://127.0.0.1")
    client.__enter__()
    try:
        api = Wire(client, {"Authorization": f"Bearer {runtime.token}"})
        workspace = api.ok("workspaces.open", {
            "requestId": "tri-open-ws", "environment": ENVIRONMENT, "path": "/home/tester/tri"})["workspace"]
        profile = client.post(
            "/api/v1/profiles",
            headers={**api.headers, "Idempotency-Key": "tri-profile"},
            json={"name": "tri", "harness_type": "alpha",
                  "configuration": {"model": "alpha-default"}, "credential_id": None})
        assert profile.status_code == 201, profile.json()
        accepted = api.ok("sessions.createAndSend", {
            "requestId": "tri-send", "workspaceId": workspace["id"],
            "profileId": profile.json()["profile_id"], "message": MESSAGE, "overrides": []})
        return runtime, client, api, port, accepted
    except Exception:
        client.__exit__(None, None, None)
        raise


