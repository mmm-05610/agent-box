/bin/bash -lc 'PYTHONPATH="src:$(find plugins -mindepth 2 -maxdepth 2 -type d -name src | paste -sd:)" .venv/bin/python - <<'"'PY'
import threading
from agent_box.server.execution.sidecar_backend import SidecarExecutionBackend, _Run
from agent_box.server.execution.execution_contract import ExecutionRequest, CancelOutcome

def backend(factory):
    return SidecarExecutionBackend(None,None,None,port_factory=factory)

# Deterministic submit race: every caller must reach factory before any returns.
n=4
factory_barrier=threading.Barrier(n)
ports=[]
class P:
    def __init__(self): self.opens=0
    def open_execution(self,key): self.opens += 1; return \"native\"
    def cancel(self,key): return True
def factory(context,on_event):
    p=P(); ports.append(p); factory_barrier.wait(5); return p
b=backend(factory)
req=ExecutionRequest(\"same-key\",\"bundle\")
receipts=[]; errors=[]
ts=[threading.Thread(target=lambda: receipts.append(b.submit(req))) for _ in range(n)]
for t in ts: t.start()
for t in ts: t.join(10)
print(\"submit_threads_alive\", sum(t.is_alive() for t in ts))
print(\"submit_ports\", len(ports), \"open_dispatches\", sum(p.opens for p in ports),
      \"receipt_dispatch_ids\", len({r.dispatch_id for r in receipts}), \"errors\", errors)

# Deterministic cancel race: pause first caller after it releases cancel_lock,
# before it can register the receipt; let the second caller enter and dispatch.
class ExitWindowLock:
    def __init__(self):
        self.inner=threading.Lock(); self.exit_count=0
        self.second_dispatched=threading.Event()
    def __enter__(self): self.inner.acquire(); return self
    def __exit__(self,*args):
        self.exit_count += 1
        first=self.exit_count == 1
        self.inner.release()
        if first: self.second_dispatched.wait(5)
class CP:
    def __init__(self, marker): self.calls=0; self.marker=marker; self.mu=threading.Lock()
    def cancel(self,key):
        with self.mu:
            self.calls += 1
            if self.calls == 2: self.marker.set()
        return True
b2=backend(lambda c,e:None)
lock=ExitWindowLock(); port=CP(lock.second_dispatched)
run=_Run(\"cancel-key\",\"w\",\"x\",\"d\",port,\"n\",threading.Event(),cancel_lock=lock)
with b2._lock: b2._active[\"cancel-key\"]=run
outs=[]
t1=threading.Thread(target=lambda: outs.append(b2.cancel_execution(\"cancel-key\")))
t2=threading.Thread(target=lambda: outs.append(b2.cancel_execution(\"cancel-key\")))
t1.start()
while port.calls < 1: pass
t2.start()
t1.join(10); t2.join(10)
print(\"cancel_threads_alive\", int(t1.is_alive())+int(t2.is_alive()))
print(\"cancel_dispatches\", port.calls, \"outcomes\", [x.value for x in outs])
