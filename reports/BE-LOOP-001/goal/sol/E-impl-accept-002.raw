  1205	def _terminal_reason_from_result(result) -> str | None:
  1206	    """Order 134 (122 consumer side): a harness completion may report *why* it
  1207	    stopped. Return a persisted terminal_reason only when the result actually
  1208	    says the turn stopped for a non-clean reason (e.g. ``max_tokens``); a
  1209	    missing field or a clean end returns ``None`` so behavior is byte-identical
  1210	    to before. We never invent a reason the Worker did not send.
  1211	    """
  1212	    if not isinstance(result, dict):
  1213	        return None
  1214	    stop = result.get("stopReason") or result.get("stop_reason")
  1215	    if not isinstance(stop, str) or stop.strip().lower() in _CLEAN_STOP_REASONS:
  1216	        return None
  1217	    return stop

