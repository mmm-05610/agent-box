  1090	def _capability_gate(port: SidecarHarnessPort, turn_id: str) -> None:
  1091	    """Refuse an execution whose slice capabilities are not provably satisfied.
  1092	
  1093	    demand 取 launcher 本次将实际执行的挂载面（executable/projection/artifact
  1094	    的 target 与 state target）；grant/声明/授权集/环境绑定由装配边界注入。
  1095	    选择为确定性单候选（authorized_providers 限定）；任何缺失或不满足都在
  1096	    ``open_execution`` 之前抛出，调用方沿既有 fail_turn 路径持久化，零 spawn。
  1097	    """
  1098	    launcher = getattr(port, "launcher", None)
  1099	    documents = getattr(port, "capability_documents", ())
  1100	    grants = getattr(port, "capability_grants", ())
  1101	    authorized = getattr(port, "capability_authorized_providers", ())
  1102	    binding = getattr(port, "capability_binding", None)
  1103	    if binding is None or not documents or not authorized:
  1104	        # 绑定、候选声明与授权提供者集是“装配边界已为本次执行注入材料”的最低
  1105	        # 标志；任一缺失即 fail-closed 拒绝（空面部署的合法空 grant 集不是缺失，
  1106	        # 但空的授权集不是“不限制”，而是未注入——不得改写为放行）。
  1107	        raise CapabilityGateRefusal(
  1108	            "capability material incomplete for this execution: "
  1109	            "binding/documents/authorized required",
  1110	        )
  1111	    executable_targets = tuple(
  1112	        target for _source, target in getattr(launcher, "executable_mounts", ())
  1113	    )
  1114	    projection_targets = tuple(
  1115	        target for _source, target in getattr(launcher, "projection_mounts", ())
  1116	    )
  1117	    artifact_targets = tuple(
  1118	        target for _source, target in getattr(launcher, "runtime_artifact_mounts", ())
  1119	    )
  1120	    state_target = getattr(launcher, "state_target", None)
  1121	    requirements = capability.sidecar_requirements(
  1122	        executable_targets=executable_targets,
  1123	        projection_targets=projection_targets,
  1124	        artifact_targets=artifact_targets,
  1125	        state_target=state_target,
  1126	    )
  1127	    context = capability.MatchContext(environment_binding=binding, now=int(time.time()))
  1128	    record = capability.select_declaration(
  1129	        requirements, grants, (), tuple(documents),
  1130	        context=context, binding=f"turn:{turn_id}",
  1131	        authorized_providers=tuple(authorized),
  1132	    )
  1133	    if record.selected is not None and record.outcome is not None and record.outcome.satisfied:
  1134	        return
  1135	    if record.rejected:
  1136	        _provider, _revision, reason = record.rejected[0]
  1137	    elif record.outcome is not None and record.outcome.refusals:
  1138	        reason = record.outcome.refusals[0].reason
  1139	    else:
  1140	        reason = "no authorized candidate satisfied the requirements"
  1141	    raise CapabilityGateRefusal(
  1142	        f"capability requirements unsatisfied for this execution: {reason}",
  1143	    )
