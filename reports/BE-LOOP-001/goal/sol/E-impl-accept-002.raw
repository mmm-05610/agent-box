   438	    def _native_event(self, turn_id: str, kind: str, data: Mapping[str, Any], port) -> None:
   439	        if kind == "message.delta":
   440	            text = str(data.get("text", ""))
   441	            if text:
   442	                self.records.append_turn_event(turn_id, kind, {"text": text})
   443	                with self._lock:
   444	                    self._message_parts.setdefault(turn_id, []).append(text)
   445	        elif kind == "approval.requested":
   446	            context = self.records.get_turn_context(turn_id)
   447	            raw = dict(data.get("request") or {})
   448	            approval = self.approvals.request(
   449	                session_id=context["session_id"], execution_id=turn_id, request=raw,
   450	            )
   451	            # Order 65: a subagent's `ask` rises into the parent turn as the
   452	            # same kind of interruption the parent already handles - the
   453	            # approval id is what the existing decide round-trip takes, so no
   454	            # second mechanism exists to bypass.
   455	            parent_turn = context.get("parent_turn_id")
   456	            if parent_turn:
   457	                self.records.append_turn_event(
   458	                    str(parent_turn), "approval.requested",
   459	                    {"approval_id": approval["approvalId"], "version": 1,
   460	                     "request": raw,
   461	                     "from_subagent": {"turnId": turn_id,
   462	                                       "sessionId": context["session_id"]}},
   463	                )
   464	            request_id = str(raw.get("requestId") or "")
   465	            if request_id:
   466	                port.register_approval(approval["approvalId"], turn_id, request_id)
   467	                with self._lock:
   468	                    self._approval_ports[approval["approvalId"]] = port
   469	        elif kind == "failed":
   470	            self.records.append_turn_event(turn_id, "tool.update", {
   471	                "state": "failed", "tool_call_id": "harness", "tool": None,
   472	                "summary": str(data.get("code") or "HARNESS_FAILED"),
   473	            })
   474	        elif kind == "thought.delta":
   475	            text = str(data.get("text") or "")
   476	            if text:
   477	                self.records.append_turn_event(turn_id, "thought.delta", {"text": text})
   478	        elif kind == "tool.update":
   479	            # The real tool lifecycle from the harness (Order 52): recorded as
   480	            # facts, arguments and outputs trimmed and scanned by the same
   481	            # rules that guard every stored event.
   482	            self.records.append_turn_event(turn_id, "tool.update", {
   483	                "tool_call_id": str(data.get("tool_call_id") or "tool"),
   484	                "tool": data.get("tool"),
   485	                "state": str(data.get("state") or "requested"),
   486	                **({"summary": str(data["summary"])[:512]} if data.get("summary") else {}),
   487	            })
   488	        elif kind == "plan.updated":
   489	            self.records.append_turn_event(turn_id, "plan.updated", {
   490	                "entries": data.get("entries") if isinstance(data.get("entries"), list) else [],
   491	            })
   492	        elif kind == "mode.updated":
   493	            self.records.append_turn_event(turn_id, "mode.updated", {
   494	                "currentModeId": str(data.get("currentModeId") or ""),
   495	            })
   496	        self.on_event()
