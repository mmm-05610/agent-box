  1146	#: The codes a **pre-start refusal** owns. They are claims about a stage - "the
  1147	#: start was refused before any native contact" - and only
  1148	#: :class:`CapabilityGateRefusal` may make that claim. A post-open failure that
  1149	#: merely reuses one of these strings is not making that claim, so the ambiguous
  1150	#: stage must not publish it (LNX-002 ruling, decision 1).
  1151	#:
  1152	#: This is the mirror of a global allow-list, not a copy of one: the vocabulary is
  1153	#: owned by the type that raises it, and the same string published from a genuine
  1154	#: pre-start refusal stays correct - that path is an ``ExecutionStartRejected`` and
  1155	#: never reaches the check in ``_safe_code``.
  1156	PRE_START_REFUSAL_CODES = frozenset({"CAPABILITY_REQUIREMENT_UNSATISFIED"})
  1157	
  1158	
  1159	
  1160	def _safe_code(exc: BaseException) -> str:
  1161	    # 先沿异常链寻找由 provider 显式标注的「启动未发生」拒绝码（gate 在
  1162	    # open_execution 前抛出的 ExecutionStartRejected 会带上原因码）；只有这一类
  1163	    # 带码的 ExecutionStartRejected 参与还原，其他包装/运行期异常保持既有归一化。
  1164	    seen: set[int] = set()
  1165	    current: BaseException | None = exc
  1166	    while current is not None and id(current) not in seen:
  1167	        seen.add(id(current))
  1168	        if isinstance(current, ExecutionStartRejected):
  1169	            explicit = getattr(current, "code", None)
  1170	            if isinstance(explicit, str) and re.fullmatch(r"[A-Z][A-Z0-9_]{2,127}", explicit):
  1171	                return explicit
  1172	        current = current.__cause__ or current.__context__
  1173	    if isinstance(exc, DispatchAmbiguous) and getattr(exc, "code", None) in PRE_START_REFUSAL_CODES:
  1174	        # LNX-002 ruling, decision 1. The ambiguous stage asserts one thing only:
  1175	        # we cannot tell whether the start and its side effects happened. A code
  1176	        # that belongs to the pre-start refusal vocabulary is a claim about a
  1177	        # stage this stage cannot make, so the *published* reason stays generic and
  1178	        # the original cause stays on the chain (and on this log).
  1179	        #
