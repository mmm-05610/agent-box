 succeeded in 0ms:
   421	            except SidecarError as exc:
   422	                if exc.code != "SIDECAR_CLOSED":
   423	                    raise
   424	                last = exc
   425	                if attempt == self.PROMPT_REBUILD_LIMIT:
   426	                    break
   427	                remaining = deadline - time.monotonic()
   428	                if remaining > 0:
   429	                    time.sleep(min(self.PROMPT_REBUILD_BACKOFF_SECONDS / (attempt + 1), remaining))
   430	                # Rebuild this execution on a fresh sidecar, then retry.
   431	                port.close_execution(turn_id)
   432	                port.open_execution(turn_id)
   433	        raise SidecarRunRecoveryFailure(
   434	            "sidecar stayed closed after "
   435	            f"{self.PROMPT_REBUILD_LIMIT} rebuild attempt(s); last: {last}",
   436	        )
