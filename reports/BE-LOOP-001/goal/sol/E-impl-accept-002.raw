   947	def _effective_attachment_support(port, execution_id: str) -> bool:
   948	    """Read the effective `attach` capability from the port's canonical view.
   949	
   950	    The answer comes from the intersection of the deployment's static
   951	    declaration and what this execution actually observed, never from a stored
   952	    snapshot or from the mere presence of an attachment.
   953	    """
   954	    view = port.effective_capabilities(execution_id)
   955	    for entry in view.get("capabilities", ()):
   956	        if entry.get("id") == "attach":
   957	            return bool(entry.get("supported"))
   958	    return False
