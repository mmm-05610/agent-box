   729	    def cancel(self, turn_id: str) -> bool:
   730	        """Temporary bool shell over the three-state verb (C-EXEC@v1 O-3).
   731	
   732	        Only ``confirmed_stopped`` answers True - refused and unknown are both
   733	        False here because that is exactly the collapse the current consumer
   734	        already projects (public shape frozen, M-1). The shell is deleted after
   735	        the consumer switches to ``cancel_execution`` (separate approval).
   736	        """
   737	        return self.cancel_execution(turn_id) is CancelOutcome.CONFIRMED_STOPPED
   738	
   739	    def cancel_execution(self, execution_key: str) -> CancelOutcome:
   740	        """Block-1 tristate cancel. A lost answer is captured and classified
   741	        ``unknown`` here - it is never re-dispatched blindly and never allowed
   742	        to leak as an exception, because both would erase the distinction the
   743	        contract promises the consumer.
   744	        """
   745	        with self._lock:
   746	            prior = self._cancel_receipts.get(execution_key)
   747	            target = self._active.get(execution_key) or self._neutral_runs.get(execution_key)
   748	        if prior is not None:
   749	            return prior
   750	        if target is None:
   751	            outcome = CancelOutcome.REFUSED_NO_ACTIVE_RUN
   752	            with self._lock:
   753	                self._cancel_receipts[execution_key] = outcome
   754	            return outcome
   755	        with target.cancel_lock:
   756	            with self._lock:
   757	                prior = self._cancel_receipts.get(execution_key)
   758	            if prior is not None:
   759	                return prior
   760	            try:
   761	                accepted = target.port.cancel(execution_key)
   762	            except BaseException:  # noqa: BLE001 - timeout/channel-lost: honest unknown
   763	                accepted = None
   764	            if accepted is None:
   765	                outcome = CancelOutcome.UNKNOWN
   766	            elif accepted:
   767	                outcome = CancelOutcome.CONFIRMED_STOPPED
   768	                target.cancel_confirmed = True
   769	            else:
   770	                outcome = CancelOutcome.REFUSED_NO_ACTIVE_RUN
   771	            # recorded while still holding the run's cancel lock: a racer
   772	            # woken from that lock must find the receipt, never a window
   773	            # in which it would dispatch the abort a second time.
   774	            with self._lock:
   775	                self._cancel_receipts[execution_key] = outcome
   776	        return outcome
   777	
   778	    def observe_execution(self, execution_key: str) -> ExecutionObservation:
   779	        """Pure read of what this process currently knows (E-D2 supplement A).
   780	
   781	        Dispatches nothing, writes nothing, and never invents a transition:
   782	        ``NOT_KNOWN_TO_E`` is bounded knowledge, not a proof that nothing ever
   783	        started - only a typed provider-side zero-creation fact may lift an
   784	        ambiguous dispatch, and that proof arrives through the consumer's
   785	        channel, never from this method.
   786	        """
   787	        now = datetime.now(timezone.utc)
   788	        with self._lock:
   789	            run = self._active.get(execution_key)
   790	            neutral = self._neutral_runs.get(execution_key)
   791	        if run is not None:
   792	            if run.result is not None:
   793	                state, evidence = ObservationState.TERMINAL, EvidenceClass.TERMINAL_RECEIPT
   794	            elif run.cancel_confirmed:
   795	                state, evidence = (
   796	                    ObservationState.STOPPED_CONFIRMED, EvidenceClass.CANCEL_CONFIRMATION)
   797	            elif run.native_id:
   798	                state, evidence = ObservationState.RUNNING, EvidenceClass.NATIVE_REPORT
   799	            else:
   800	                state, evidence = ObservationState.RUNNING, EvidenceClass.DISPATCH_ACK
   801	        elif neutral is not None:
   802	            if neutral.cancel_confirmed:
   803	                state, evidence = (
   804	                    ObservationState.STOPPED_CONFIRMED, EvidenceClass.CANCEL_CONFIRMATION)
   805	            elif neutral.evidence:
   806	                state, evidence = ObservationState.RUNNING, EvidenceClass.NATIVE_REPORT
   807	            else:
   808	                state, evidence = ObservationState.RUNNING, EvidenceClass.DISPATCH_ACK
   809	        else:
   810	            state, evidence = ObservationState.NOT_KNOWN_TO_E, EvidenceClass.NONE
   811	        return ExecutionObservation(execution_key, state, evidence, now)
   812	
   813	    def submit(self, request: ExecutionRequest) -> ExecutionReceipt:
   814	        """Neutral start path - no business record is created, read, or
   815	        inferred here (the caller issues ``execution_key`` after its own
   816	        bookkeeping; persistence of ``correlation`` is the caller's).
   817	
   818	        A replay of a key already tracked returns the original receipt and
   819	        never re-dispatches the start. A typed refusal raised before the port
   820	        exists left no dispatch behind, so it registers nothing and leaves the
