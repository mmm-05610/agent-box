   390	    #: How many times a freshly-opened sidecar may be rebuilt when a prompt
   391	    #: finds it already closed (the drain the same second a prior sidecar exits,
   392	    #: ACC-R2-1). Bounded on purpose: recovery is not an infinite retry.
   393	    PROMPT_REBUILD_LIMIT = 2
   394	    #: Upper bound on the total backoff spent waiting out an in-flight teardown
   395	    #: across those rebuilds; the wait is bounded, never open-ended.
   396	    PROMPT_REBUILD_BACKOFF_SECONDS = 0.2
   397	
   398	    def _prompt_with_rebuild(self, port, turn_id, prompt_content, attachments):
   399	        """Prompt the execution's sidecar, rebuilding it if it is already closed.
   400	
   401	        Order 106: the queue drain starts in the same second the previous turn
   402	        reaches *completed*, and that previous sidecar is mid-teardown. The
   403	        successor turn gets its own fresh sidecar, but the overlap still surfaces
   404	        as ``SIDECAR_CLOSED`` at the prompt boundary - a queued message the user
   405	        sees die in a second. Here the drained (and any) turn ensures a live
   406	        sidecar before it gives up: on ``SIDECAR_CLOSED`` it drops the dead
   407	        envelope, reopens a fresh sidecar on the SAME execution, and re-prompts -
   408	        bounded by ``PROMPT_REBUILD_LIMIT`` and a bounded backoff. If every
   409	        rebuild still finds a closed sidecar, the failure is typed
   410	        (``SIDECAR_REBUILD_FAILED``) rather than left as an ambiguous close.
   411	
   412	        It reuses the new-turn open path (``open_execution``) rather than a second
   413	        dispatch path, so it never re-dispatches the turn and touches no queue,
   414	        idempotency or wire semantics.
   415	        """
   416	        deadline = time.monotonic() + self.PROMPT_REBUILD_BACKOFF_SECONDS
   417	        last: SidecarError | None = None
   418	        for attempt in range(self.PROMPT_REBUILD_LIMIT + 1):
   419	            try:
   420	                return port.prompt(turn_id, prompt_content, attachments)

