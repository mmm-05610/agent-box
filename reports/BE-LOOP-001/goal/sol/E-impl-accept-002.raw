   672	    def _retire_run(self, run: "_Run") -> None:
   673	        """Release every shared handle a run holds, so a failed turn cannot leak
   674	        the active maps, the bound resources, or the provider dispatch handle.
   675	
   676	        Each step is independent: one raising must not strand the others (that
   677	        leak is what accumulated across failures into the order-109 HTTP hang).
   678	        """
   679	        with self._lock:
   680	            self._active.pop(run.turn_id, None)
   681	            self._contexts.pop(run.turn_id, None)
   682	            self._message_parts.pop(run.turn_id, None)
   683	            self._turn_by_core.pop(run.core_execution_id, None)
   684	            self._approval_ports = {
   685	                key: value for key, value in self._approval_ports.items() if value is not run.port
   686	            }
   687	        try:
   688	            self.resources.release(run.turn_id)
   689	        except BaseException:
   690	            logging.getLogger(__name__).exception(
   691	                "turn %s: bound-resource release failed", run.turn_id)
   692	        try:
   693	            self.provider.release_handle(run.dispatch_id)
   694	        except BaseException:
   695	            logging.getLogger(__name__).exception(
   696	                "turn %s: provider handle release failed", run.turn_id)
   697	
   698	    def _complete_then_retire(self, run: "_Run") -> None:
   699	        """Run the durable completion and stop being a live worker afterwards."""
   700	        try:
   701	            self._complete(run)
   702	        finally:
   703	            # Order 80: this run's terminal is what makes the library "ready" —
   704	            # every later run (and anyone waiting) passes through from here.
   705	            if run.first_run_hold is not None:
   706	                run.first_run_hold.release()
   707	            with self._lock:
   708	                self._completion_threads.discard(threading.current_thread())
   709	
   710	    def pid_for(self, turn_id: str) -> int | None:
   711	        """The execution-side pid for one in-flight turn, if this side has it.
   712	
   713	        A local run's process object is the only source; a Worker-hosted run
   714	        has none here, and an unknown turn is simply "not reported" - the
   715	        inventory shows null rather than a guess.
   716	        """
   717	        with self._lock:
   718	            run = self._active.get(turn_id)
   719	        if run is None:
   720	            return None
   721	        pid = getattr(run.port, "pid", None)
