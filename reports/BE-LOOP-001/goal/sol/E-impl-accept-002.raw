   961	def _reclaim_subscription(run: "_Run") -> None:
   962	    """Copy the declared working files back into the account asset.
   963	
   964	    Every failure here is typed and recorded; none of them replace the stored
   965	    asset (order 56 §1: never a half-way overwrite), and none of them fail the
   966	    turn after the fact - the turn's own result is already durable.
   967	    """
   968	    subscription = getattr(run.port, "subscription", None)
   969	    plumbing = getattr(run.port, "account_plumbing", None)
   970	    if not subscription or not plumbing:
   971	        return
   972	    records, asset_store = plumbing
   973	    account_id = subscription["account_id"]
   974	    declared = subscription["files"]
   975	
   976	    def stored_digest_of():
   977	        _locator, digest = records.asset_reference(account_id)
   978	        return digest
   979	
   980	    try:
   981	        read = getattr(run.port, "read_subscription", None)
   982	        working = read(run.turn_id) if callable(read) else {}
   983	        if not working:
   984	            return
   985	        locator, digest = asset_store.reclaim(
   986	            account_id=account_id,
   987	            stored_digest_of=stored_digest_of,
   988	            materialized_digest=subscription.get("materialized_digest"),
   989	            files=working,
   990	            kind="subscription",
   991	        )
   992	        records.record_asset(account_id, locator=locator, digest=digest, state="valid")
   993	    except BaseException as error:  # noqa: BLE001 - recorded, never silent
   994	        logging.getLogger(__name__).warning(
   995	            "turn %s: subscription reclaim for %s refused (%s); the stored "
   996	            "asset is unchanged", run.turn_id, account_id,
   997	            getattr(error, "code", type(error).__name__),
   998	        )
