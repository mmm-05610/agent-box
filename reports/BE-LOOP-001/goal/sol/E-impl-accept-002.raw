  1001	def _audited_home(run: "_Run") -> tuple[dict[str, Any], bool]:
  1002	    """Audit the home of a finished attempt, applying the credential rule.
  1003	
  1004	    An injected value found in the home means the one-shot projection leaked:
  1005	    the file that carries it is deleted (the home stays usable for the next
  1006	    turn), and the typed failure records the fact - the turn does not pass
  1007	    with a secret sitting in a durable directory.
  1008	    """
  1009	    try:
  1010	        audit, resumable = run.port.capture_execution(run.turn_id)
  1011	        # Order 51: read the declared usage journal while the execution's own
  1012	        # channel is still alive (after the final state, the sidecar is gone
  1013	        # and a read would arrive too late). The result rides on the run.
  1014	        usage_probe = getattr(run.port, "usage_probe", None)
  1015	        if usage_probe:
  1016	            try:
  1017	                run.usage_fact = run.port.read_usage(run.turn_id, usage_probe)
  1018	                run.usage_source = usage_probe.get("format")
  1019	            except BaseException as read_error:
  1020	                # A failed usage read must not fail the turn: the fact simply
  1021	                # stays unknown, and the reason is logged for the report.
  1022	                logging.getLogger(__name__).warning(
  1023	                    "turn %s: usage read failed (%s); usage stays unknown",
  1024	                    run.turn_id, read_error,
  1025	                )
  1026	                run.usage_fact = None
  1027	                run.usage_source = None
  1028	        # Order 56: reclaim the subscription working copy while the channel is
  1029	        # still alive. A reclaim that cannot take the account's lock, or that
  1030	        # finds the stored asset moved, is recorded and never overwrites the
  1031	        # asset - the working copy simply stays unclaimed.
  1032	        _reclaim_subscription(run)
  1033	        return audit, resumable
  1034	    except BaseException as exc:
  1035	        if getattr(exc, "code", None) == "SIDECAR_STATE_CONTAINS_SECRET":
  1036	            relative = getattr(exc, "path", None)
  1037	            disposition = _credential_hit_disposition(exc, run.port)
  1038	            if disposition == "keep-shared":
  1039	                logging.getLogger(__name__).warning(
  1040	                    "turn %s: credential material found in the shared session "
  1041	                    "library at %s; the shared file is left in place (order 66)",
  1042	                    run.turn_id, relative,
  1043	                )
  1044	            elif disposition == "delete" and relative:
  1045	                try:
  1046	                    run.port.delete_home_file(run.turn_id, relative)
  1047	                except BaseException:  # noqa: BLE001 - the leak failure stands
  1048	                    pass
  1049	        raise
  1050	
  1051	
  1052	def _credential_hit_disposition(exc: BaseException, port: Any) -> str:
  1053	    """What to do with one credential-hit audit failure (order 66 §2.5).
  1054	
  1055	    ``keep-shared`` - the audited tree is the shared family library: the hit
  1056	    stays a typed failure, but the file must not be deleted (it may hold other
  1057	    Profiles' sessions). ``delete`` - a profile-scoped tree: the old rule, the
  1058	    leaked file is removed. ``none`` - not a credential hit at all.
  1059	    """
  1060	    if getattr(exc, "code", None) != "SIDECAR_STATE_CONTAINS_SECRET":
  1061	        return "none"
  1062	    return "keep-shared" if getattr(port, "shared_store", False) else "delete"
