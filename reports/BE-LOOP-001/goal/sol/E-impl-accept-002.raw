   921	def _sidecar_attachments(
   922	    objects, stored: Mapping[str, Any],
   923	) -> tuple[list[dict[str, Any]], list[str]]:
   924	    """Project stored attachments into (native image attachments, file refs).
   925	
   926	    Image bytes are read from the bounded object store only when the attachment
   927	    carries a content digest; every other attachment stays a workspace file
   928	    reference that the prompt text may name.
   929	    """
   930	    attachments: list[dict[str, Any]] = []
   931	    file_refs: list[str] = []
   932	    for item in (stored.get("message") or stored).get("attachments", ()):
   933	        digest_value = item.get("_contentDigest")
   934	        if not digest_value:
   935	            continue
   936	        if item.get("mediaKind") == "image":
   937	            attachments.append({
   938	                "mime": item.get("_mime") or "application/octet-stream",
   939	                "filename": item.get("displayName") or item.get("ref"),
   940	                "data": base64.b64encode(objects.read(digest_value)).decode(),
   941	            })
   942	        else:
   943	            file_refs.append(str(item.get("ref")))
   944	    return attachments, file_refs
