   884	    #: How long `stop()` waits for prompts and durable completions to settle.
   885	    STOP_DEADLINE_SECONDS = 15.0
   886	
   887	    def stop(self) -> bool:
   888	        with self._lock:
   889	            runs = list(self._active.values())
   890	        for run in runs:
   891	            self.cancel(run.turn_id)
   892	        deadline = time.monotonic() + self.STOP_DEADLINE_SECONDS
   893	        for run in runs:
   894	            run.done.wait(max(0, deadline - time.monotonic()))
   895	        # The prompt worker finishing is not the end of the turn: the completion
   896	        # worker still writes the durable result through the shared Work Core
   897	        # connection. Returning before it finishes let a later shutdown (or the
   898	        # next test) reset that connection underneath it, which crashed the
   899	        # interpreter inside SQLite. Wait for it, bounded, and report honestly.
   900	        for thread in list(self._completion_threads):
   901	            thread.join(max(0, deadline - time.monotonic()))
   902	        prompts_done = all(run.done.is_set() for run in runs)
   903	        # Order 80: a run that never reached its terminal must not keep its
   904	        # library's first-run lock (a later runtime in this process, or a
   905	        # restart of the same data root, would wait on a dead owner).
   906	        with self._lock:
   907	            leftovers = [run for run in self._active.values()
   908	                         if run.first_run_hold is not None]
   909	        for run in leftovers:
   910	            run.first_run_hold.release()
   911	        with self._lock:
   912	            # Keep the set meaning "workers still running": a finished worker is
   913	            # retired here even if it was not started through the wrapper.
   914	            self._completion_threads = {
   915	                thread for thread in self._completion_threads if thread.is_alive()
   916	            }
   917	            completions_done = not self._completion_threads
   918	        return prompts_done and completions_done
