  1070	    即使返回同名错误码（SidecarError 基类），也绝不会被误标为启动前拒绝。
  1071	    """
  1072	
  1073	    def __init__(self, reason: str) -> None:
  1074	        super().__init__("CAPABILITY_REQUIREMENT_UNSATISFIED", reason)
