# The lockfile's `resolved` URLs were baked from the local npm mirror
# (registry.npmmirror.com).  GitHub CI runners (US) can't reach that mirror
# reliably.  `replace-registry-host=always` makes npm substitute the
# CURRENTLY CONFIGURED registry for the baked-in host — so CI uses npmjs.org
# while local dev keeps its China mirror.  No registry is pinned here.
replace-registry-host=always
