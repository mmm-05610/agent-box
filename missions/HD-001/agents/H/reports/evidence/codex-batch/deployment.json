{
  "harnesses": [
    {
      "adapter": {
        "args": [
          "/runtime/artifacts/codex-runtime/node_modules/@agentclientprotocol/codex-acp/dist/index.js"
        ],
        "command": "/usr/bin/node",
        "environment": {
          "CODEX_HOME": "/runtime/home/.codex",
          "NO_BROWSER": "1"
        }
      },
      "capabilityClaims": {
        "attach": true,
        "finish": true,
        "native_continuation": true,
        "observe": true,
        "permissions": true,
        "start": true,
        "steer": false,
        "stream": true
      },
      "controlOptions": {
        "model": []
      },
      "credentialEnvironment": "CODEX_API_KEY",
      "credentialKind": "api-key",
      "id": "codex",
      "modelControlId": "model",
      "preferredAuthMethod": "api-key",
      "projectionFiles": [
        {
          "source": "deploy/codex/config.toml",
          "target": "/runtime/home/.codex/config.toml"
        },
        {
          "source": "deploy/codex/models.json",
          "target": "/runtime/home/.codex/models.json"
        }
      ],
      "runtimeArtifactMounts": [
        {
          "target": "/runtime/artifacts/codex-runtime",
          "token": "codex-runtime",
          "treeDigest": "sha256:9051b844a8feeb241667dd0cc03e80d082e140e88e49ecb3f195385e209f2ca1"
        }
      ],
      "sessionStore": {
        "kind": "sessions-subtree"
      },
      "stateProjection": {
        "ephemeralPaths": [
          ".tmp",
          "shell_snapshots"
        ],
        "target": "/runtime/home/.codex/sessions"
      },
      "subscriptionCredential": {
        "files": [
          ".codex/auth.json"
        ]
      },
      "timeoutMs": 120000,
      "usageProbe": {
        "format": "codex-rollout",
        "journalSuffix": ".jsonl"
      },
      "wireProtocols": {
        "openai-chat": "chat",
        "openai-responses": "responses"
      }
    }
  ],
  "schemaVersion": 1
}
