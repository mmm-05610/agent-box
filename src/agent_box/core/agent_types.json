{
  "claude": {
    "identity": {
      "display_name": "Claude Code",
      "binary": "claude",
      "color": "#D97757",
      "logo": "logos/claude.svg"
    },
    "runtime": {
      "config_dir": "~/.claude",
      "profile_dir_suffix": "dot-claude",
      "extra_profile_files": [
        "dot-claude.json",
        "dot-agents/"
      ],
      "launch": {
        "interactive": [
          "claude"
        ],
        "exec": [
          "claude",
          "-p"
        ],
        "resume": [
          "claude",
          "-c"
        ],
        "resume_by_id": [
          "claude",
          "-r",
          "{session}"
        ]
      },
      "acs_column": "enabled_claude",
      "install": "npm install -g @anthropic-ai/claude-code@latest",
      "latest": { "type": "npm", "package": "@anthropic-ai/claude-code" }
    },
    "resources": {
      "provider": {
        "apply_mode": "overwrite",
        "strategy": "json_merge",
        "config_file": "settings.json",
        "env_source_key": "env",
        "metadata_key": "_provider"
      },
      "mcp": {
        "config_file": "dot-claude.json",
        "root_key": "mcpServers",
        "at_profile_root": true,
        "entry_format": "passthrough"
      },
      "hooks": {
        "format": "json",
        "config_file": "settings.json",
        "key": "hooks"
      },
      "prompt": {
        "file": "CLAUDE.md"
      },
      "skills": {
        "dir": "skills"
      },
      "permissions": {
        "config_file": "settings.json",
        "config_key": "permissions",
        "blocks": [
          {
            "type": "rule_groups",
            "groups": [
              "allow",
              "deny",
              "ask"
            ],
            "rule_format": "tool(pattern)",
            "suggested_tools": [
              "Bash",
              "Read",
              "Edit",
              "Write",
              "Glob",
              "Grep",
              "WebFetch",
              "WebSearch",
              "Task",
              "Skill",
              "Agent",
              "NotebookEdit"
            ]
          },
          {
            "type": "select",
            "field": "defaultMode",
            "options": [
              "default",
              "acceptEdits",
              "plan",
              "auto",
              "dontAsk",
              "bypassPermissions"
            ]
          }
        ]
      },
      "plugins": {
        "config_file": "settings.json",
        "installed_file": "installed_plugins.json",
        "config_key": "enabledPlugins"
      }
    },
    "sandbox": {
      "bind_mounts": [
        "/"
      ],
      "dev_mounts": [
        "/dev"
      ],
      "proc_mounts": [
        "/proc"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "unshare": [
        "ipc",
        "pid",
        "uts"
      ],
      "share": [
        "net"
      ]
    },
    "presets": {
      "CLAUDE.md": {
        "dest": "CLAUDE.md",
        "merge": "copy"
      },
      "hooks.json": {
        "dest": "hooks/hooks.json",
        "merge": "copy"
      },
      "settings.overlay.json": {
        "dest": "settings.json",
        "merge": "deep_merge"
      }
    }
  },
  "codex": {
    "identity": {
      "display_name": "Codex",
      "binary": "codex",
      "color": "#10A37F",
      "logo": "logos/openai.svg"
    },
    "runtime": {
      "config_dir": "~/.codex",
      "profile_dir_suffix": "dot-codex",
      "config_files": [
        "config.toml",
        "auth.json"
      ],
      "launch": {
        "interactive": [
          "codex"
        ],
        "exec": [
          "codex",
          "exec"
        ],
        "resume": [
          "codex",
          "resume",
          "--last"
        ]
      },
      "acs_column": "enabled_codex",
      "install": "npm install -g @openai/codex@latest",
      "latest": { "type": "npm", "package": "@openai/codex" }
    },
    "resources": {
      "provider": {
        "apply_mode": "overwrite",
        "strategy": "multi_file",
        "files": [
          {
            "dest": "config.toml",
            "source_key": "config",
            "format": "text"
          },
          {
            "dest": "auth.json",
            "source_key": "auth",
            "format": "json"
          }
        ]
      },
      "mcp": {
        "config_file": "config.toml",
        "root_key": "mcp_servers"
      },
      "prompt": {
        "file": "AGENTS.md"
      },
      "skills": {
        "dir": "skills"
      },
      "permissions": {
        "config_file": "config.toml",
        "config_key": "approval_policy",
        "blocks": [
          {
            "type": "select",
            "field": "approval_policy",
            "options": [
              "untrusted",
              "on-failure",
              "on-request",
              "never"
            ]
          },
          {
            "type": "toggle_list",
            "field": "tools",
            "items": [
              "web_search",
              "view_image"
            ]
          },
          {
            "type": "raw_editor",
            "label": "shell_environment_policy"
          },
          {
            "type": "rule_files",
            "dir": "rules",
            "extension": ".rules",
            "rule_format": "prefix_rule(pattern=[...], decision=...)"
          }
        ]
      }
    },
    "sandbox": {
      "bind_mounts": [
        "/"
      ],
      "dev_mounts": [
        "/dev"
      ],
      "proc_mounts": [
        "/proc"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "unshare": [
        "ipc",
        "pid",
        "uts"
      ],
      "share": [
        "net"
      ]
    }
  },
  "hermes": {
    "identity": {
      "display_name": "Hermes",
      "binary": "hermes",
      "color": "#8B5CF6",
      "logo": "logos/hermes.png"
    },
    "runtime": {
      "config_dir": "~/.hermes",
      "profile_dir_suffix": "dot-hermes",
      "config_files": [
        "config.yaml",
        ".env"
      ],
      "venv_preserve": "hermes-agent/venv/",
      "launch": {
        "interactive": [
          "hermes"
        ],
        "exec": [
          "hermes",
          "-p"
        ],
        "resume": [
          "hermes",
          "-c"
        ]
      },
      "acs_column": "enabled_hermes",
      "install": "hermes update || bash -c 'tmp=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh -o $tmp && bash $tmp; status=$?; rm -f $tmp; exit $status'",
      "latest": { "type": "pip", "package": "hermes-agent" }
    },
    "resources": {
      "provider": {
        "apply_mode": "additive",
        "strategy": "yaml_custom_providers",
        "config_file": "config.yaml",
        "model_section": "model",
        "active_key": "provider",
        "custom_providers_section": "custom_providers",
        "metadata_fields": [
          "id",
          "name",
          "notes",
          "website_url",
          "icon",
          "icon_color",
          "category"
        ],
        "managed_yaml_keys": [
          "base_url",
          "api_key",
          "api_mode",
          "default",
          "models",
          "model",
          "providers",
          "custom_providers"
        ],
        "api_mode_mapping": {
          "chat_completions": "openai_compatible",
          "openai_compatible": "openai_compatible",
          "anthropic": "anthropic",
          "codex_responses": "codex_responses"
        },
        "entry_yaml_spec": {
          "fields": [
            {
              "yaml_key": "base_url",
              "settings_key": "base_url"
            },
            {
              "yaml_key": "api_key",
              "settings_key": "api_key",
              "env_fallback": true
            },
            {
              "yaml_key": "api_mode",
              "settings_key": "api_mode",
              "mapped": true
            }
          ],
          "model_list": {
            "settings_key": "models",
            "id_key": "id",
            "name_key": "name",
            "context_key": "context_length",
            "yaml_model_key": "model",
            "yaml_section_key": "models",
            "yaml_name_key": "name",
            "yaml_context_key": "context_length"
          },
          "default_model": {
            "settings_key": "default_model",
            "yaml_key": "model"
          }
        }
      },
      "mcp": {
        "config_file": "config.yaml",
        "root_key": "mcp_servers"
      },
      "hooks": {
        "format": "yaml",
        "config_file": "config.yaml",
        "key": "hooks"
      },
      "prompt": {
        "file": "SOUL.md"
      },
      "skills": {
        "dir": "skills"
      },
      "memories": {
        "dir": "memories",
        "files": [
          {
            "file": "MEMORY.md",
            "kind": "memory"
          },
          {
            "file": "USER.md",
            "kind": "user"
          }
        ]
      },
      "permissions": {
        "config_file": "config.yaml",
        "config_key": "approvals",
        "blocks": [
          {
            "type": "select",
            "field": "mode",
            "options": [
              "smart",
              "manual",
              "off"
            ]
          },
          {
            "type": "toggle_list",
            "field": "agent.disabled_toolsets",
            "items": [
              "browser",
              "web",
              "file",
              "terminal",
              "code",
              "vision",
              "memory",
              "delegation",
              "cron",
              "skills",
              "plugins"
            ]
          }
        ]
      }
    },
    "sandbox": {
      "bind_mounts": [
        "/"
      ],
      "dev_mounts": [
        "/dev"
      ],
      "proc_mounts": [
        "/proc"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "unshare": [
        "ipc",
        "pid",
        "uts"
      ],
      "share": [
        "net"
      ]
    }
  },
  "opencode": {
    "identity": {
      "display_name": "OpenCode",
      "binary": "opencode",
      "color": "#3B82F6",
      "logo": "logos/opencode-logo-light.svg"
    },
    "runtime": {
      "config_dir": "~/.config/opencode",
      "profile_dir_suffix": "dot-opencode",
      "data_dir": "~/.local/share/opencode",
      "config_files": [
        "opencode.jsonc"
      ],
      "launch": {
        "interactive": [
          "opencode"
        ],
        "exec": [
          "opencode",
          "run"
        ]
      },
      "acs_column": "enabled_opencode",
      "install": "npm i -g opencode-ai@latest",
      "latest": { "type": "npm", "package": "opencode-ai" }
    },
    "resources": {
      "provider": {
        "apply_mode": "additive",
        "strategy": "jsonc_provider",
        "config_file": "opencode.jsonc",
        "provider_key": "provider",
        "metadata_fields": [
          "id",
          "name",
          "notes",
          "website_url",
          "icon",
          "icon_color",
          "category"
        ]
      },
      "mcp": {
        "config_file": "opencode.jsonc",
        "root_key": "mcp",
        "servers_key": "servers",
        "entry_format": "structured"
      },
      "prompt": {
        "file": "AGENTS.md"
      },
      "skills": {
        "dir": "skills"
      },
      "instructions": {
        "config_file": "opencode.jsonc",
        "config_key": "instructions"
      },
      "permissions": {
        "config_file": "opencode.jsonc",
        "config_key": "permission",
        "blocks": [
          {
            "type": "tool_matrix",
            "tools": [
              "read",
              "edit",
              "bash",
              "glob",
              "grep",
              "list",
              "task",
              "webfetch",
              "websearch",
              "lsp",
              "skill",
              "external_directory",
              "todowrite",
              "question",
              "doom_loop"
            ],
            "values": [
              "allow",
              "ask",
              "deny"
            ]
          }
        ]
      }
    },
    "sandbox": {
      "bind_mounts": [
        "/"
      ],
      "dev_mounts": [
        "/dev"
      ],
      "proc_mounts": [
        "/proc"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "unshare": [
        "ipc",
        "pid",
        "uts"
      ],
      "share": [
        "net"
      ]
    }
  }
}
