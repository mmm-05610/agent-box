{
  "name": "ordessa-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/desktop-host",
    "packages/extension-api",
    "packages/extension-loader"
  ],
  "scripts": {
    "build:foundations": "node extensions/build.mjs",
    "dev": "npm run --workspace apps/desktop dev",
    "build": "npm run --workspace apps/desktop build",
    "typecheck": "npm run --workspace apps/desktop typecheck",
    "test": "npm run --workspace apps/desktop test",
    "test:electron": "npm run --workspace apps/desktop test:electron",
    "build:examples": "node examples/build.mjs",
    "test:extensions": "node apps/desktop/scripts/test-extensions.mjs",
    "test:foundations": "node apps/desktop/scripts/test-foundations.mjs",
    "start": "npm run --workspace apps/desktop start"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
